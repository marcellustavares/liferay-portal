Bundle-Name: Liferay OSGI Config Admin
Bundle-SymbolicName: com.liferay.osgi.config.admin
Bundle-Version: 1.0.0
Import-Package:\
	${bnd.jsp.support.imports.javax.servlet},\
	com.liferay.portlet.dynamicdatamapping.io,\
	com.liferay.portlet.dynamicdatamapping.render,\
	com.liferay.portlet.dynamicdatamapping.storage,\
	*
Include-Resource:\
	classes,\
	META-INF/resources=src/META-INF/resources,\
	META-INF/resources/tld=src/META-INF/tld,\
	@../../../../util-java/util-java.jar!/com/liferay/util/ContentUtil,\
	@../../../../util-bridges/util-bridges.jar!/com/liferay/util/bridges/freemarker/FreeMarkerPortlet