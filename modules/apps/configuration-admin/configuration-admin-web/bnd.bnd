Bundle-Name: Liferay Configuration Admin Web
Bundle-SymbolicName: com.liferay.configuration.admin.web
Bundle-Version: 1.0.0
Include-Resource:\
	classes,\
	META-INF/resources=src/META-INF/resources,\
	WEB-INF=src/WEB-INF,\
	@../../../../lib/portal/bnd.jar!/aQute/bnd/annotation/metatype/*,\
	@../../../../util-bridges/util-bridges.jar!/com/liferay/util/bridges/freemarker/FreeMarkerPortlet.class
Private-Package: com.liferay.configuration.admin.web.*

-metatype: *