{namespace Templates.View}

/**
 * Prints My Soy Portlet main view.
 *
 * @param userName
 * @param link
 */
{template .render}
	<h1>List View</h1>

	Welcome {$userName}! <a href="{$link}">Click here to navigate to another view.</a>

	<br />

	<button>Dropdown</button>

	{call Templates.Dropdown.render}
		{param alignElementSelector: 'button' /}
		{param body: '<li><a href="#">Action</a></li><li><a href="#">Another action</a></li><li><a href="#">Something else here</a></li><li><a href="#">Separated link</a></li>' /}
		{param header: '<button data-onclick="toggle" class="btn btn-primary">Dropdown <span class="caret"></span></button>' /}
		{param id: 'dropdown' /}
	{/call}
{/template}