Bundle-Name: Liferay Dynamic Data Lists Web
Bundle-SymbolicName: com.liferay.dynamic.data.lists.web
Bundle-Version: 1.0.0
Import-Package: \
	com.liferay.portlet.dynamicdatalists.service.permission,\
	com.liferay.portlet.dynamicdatamapping.io,\
	com.liferay.portlet.dynamicdatamapping.service,\
	com.liferay.dynamic.data.mapping.form.renderer,\
	com.liferay.dynamic.data.mapping.form.values.factory,\
	*
Include-Resource:\
	classes,\
	META-INF/resources=src/META-INF/resources
Require-Capability:\
	osgi.extender;filter:="(&(osgi.extender=jsp.taglib)(uri=http://java.sun.com/portlet_2_0))",\
	osgi.extender;filter:="(&(osgi.extender=jsp.taglib)(uri=http://liferay.com/tld/aui))",\
	osgi.extender;filter:="(&(osgi.extender=jsp.taglib)(uri=http://liferay.com/tld/portlet))",\
	osgi.extender;filter:="(&(osgi.extender=jsp.taglib)(uri=http://liferay.com/tld/theme))",\
	osgi.extender;filter:="(&(osgi.extender=jsp.taglib)(uri=http://liferay.com/tld/ui))"
Web-ContextPath: /ddl-web