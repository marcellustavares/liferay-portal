{namespace ddm}

/**
 * Prints the DDM form text field.
 *
 * @param dir
 * @param fieldNameSuffix
 * @param fieldQualifiedName
 * @param label
 * @param name
 * @param placeholder
 * @param value
 */
{template .text}
	<div class="form-group field-wrapper" data-fieldname="{$name}" data-fieldnamespace="{$fieldNameSuffix}">
		<label class="control-fieldLabel" for="{$fieldQualifiedName}">
			{$label}
		</label>

		 <input class="field form-control" dir="{$dir}" id="{$fieldQualifiedName}" name="{$name}" type="text" placeholder="{$placeholder}" value="{$value}"> 
	</div>
{/template}