{namespace ddm}

/**
 * Prints all pages.
 * @param fieldTypes
 * @param form
 * @param pages
 * @param portletNamespace
 * @param values
 */
{template .pages}
	{let $id: randomInt(9999) /}

	<div class="lfr-form-pages" id="{$id}">
		<div class="lfr-form-pages-content">
			<ul class="nav nav-tabs">
				{foreach $page in $pages}
					<li>
						<a href="javascript:;">{$page.title}</a>
					</li>
				{/foreach}
			</ul>
			<div class="tab-content">
				{foreach $page in $pages}
					<div class="tab-pane {if isFirst($page)}active{/if}">
						{call ddm.rows data="all"}
							{param rows: $page.rows /}
						{/call}
					</div>
				{/foreach}
			</div>
		</div>
	</div>

	<script src="/o/ddm-renderer/js/modules.js"></script>

	<script type="text/javascript">
	AUI().use(
		'liferay-ddm-form-renderer',
		function(A) {lb}
			Liferay.DDM.Renderer.FieldTypes.register({$fieldTypes|noAutoescape});

			new Liferay.DDM.Renderer.Form(
				{lb}
					container: '#{$id}',
					definition: {$form|noAutoescape},
					portletNamespace: '{$portletNamespace}',
					values: {$values|noAutoescape}
				{rb}
			);
		{rb}
	);
	</script>
{/template}

/**
 * Prints all rows.
 *
 * @param rows
 */
{template .rows}
	{foreach $row in $rows}
		<div class="row">
			{call ddm.columns data="all"}
				{param columns: $row.columns /}
			{/call}
		</div>
	{/foreach}
{/template}

/**
 * Prints all columns.
 *
 * @param columns
 */
{template .columns}
	{foreach $column in $columns}
		{call ddm.column data="all"}
			{param column: $column /}
		{/call}
	{/foreach}
{/template}

/**
 * Prints a column.
 *
 * @param column
 */
{template .column}
	<div class="field-column col-md-{$column.size}">
		{foreach $renderedDDMFormField in $column.renderedDDMFormFields}
			{if isNonnull($renderedDDMFormField)}
				<div class="field-container">
					{$renderedDDMFormField|noAutoescape}
				</div>
			{/if}
		{/foreach}
	</div>
{/template}