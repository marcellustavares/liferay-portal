{
	"LiferayDocumentType": {
		"_all" : {"enabled" : true},
		"_type": {"store": "yes"},
		"numeric_detection": true,
		"properties": {
			"articleId": {
				"index": "not_analyzed",
				"store": "yes",
				"type": "string"
			},
			"folderId": {
				"index": "not_analyzed",
				"store": "yes",
				"type": "string"
			},
			"id": {
				"index": "not_analyzed",
				"store": "yes",
				"type": "string"
			},
			"languageId": {
				"index": "not_analyzed",
				"store": "yes",
				"type": "string"
			},
			"leftOrganizationId": {
				"index": "not_analyzed",
				"store": "yes",
				"type": "string"
			},
			"nodeId": {
				"index": "not_analyzed",
				"store": "yes",
				"type": "string"
			},
			"path": {
				"index": "not_analyzed",
				"store": "yes",
				"type": "string"
			},
			"rightOrganizationId": {
				"index": "not_analyzed",
				"store": "yes",
				"type": "string"
			},
			"treePath": {
				"index": "not_analyzed",
				"store": "yes",
				"type": "string"
			},
			"uid": {
				"index": "not_analyzed",
				"store": "yes",
				"type": "string"
			}	
		},
		"dynamic_templates": [
			{
				"template_nested_root": {
					"path_match": "fields",
					"mapping": {
						"type": "nested"
					}
				}
			},
			{
				"template_nested_nodes": {
					"path_match": "fields.*",
					"path_unmatch": "fields.*.value",
					"mapping": {
						"type": "nested"
					}
				}
			},
			{
 				"template_nested_value": {
 					"path_match": "fields.*.value",
					"mapping_type": "{dynamic_type}",
 					"mapping": {
 						"index": "analyzed",
 						"store": "yes",
 						"type": "{dynamic_type}",
 						"analizer": "standard"
 					}
				}
			}
		]
	}
}